# Survival Academy frontend — environment configuration.
# VITE_* variables are embedded in the client bundle: NEVER put secrets here.
# Per-environment files: .env.development / .env.test / .env.production

# API base URL. Empty = same-origin (production default; the backend is
# served behind the same Nginx host and the session cookie is Path=/api).
VITE_API_BASE_URL=

# Dev-only: Vite proxies /api to the backend. Default http://localhost:3000.
VITE_DEV_PROXY_TARGET=http://localhost:3000

# Dev-only contract check: parses critical API responses against zod
# schemas and fails loudly on drift (silent in production builds).
VITE_CONTRACT_CHECK=1

# Stripe PUBLISHABLE key (pk_test_… — safe for browsers; TEST mode).
# The secret key lives ONLY in the backend .env — never here.
# Without this, the plans page shows the honest "billing not configured"
# state instead of a broken checkout.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
